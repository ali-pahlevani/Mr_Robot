<?xml version="1.0"?>
<!--
  ros2_control interfaces, backed by Webots.

  webots_ros2_control pairs each joint below with the Webots motor of the SAME
  name, and reads its position from a PositionSensor called "<joint>_sensor".
  Both names come out of the generated PROTO (mrrobot_webots/scripts/
  build_proto.py) directly from this URDF's joint names, so they cannot drift.

  The wheels are velocity-controlled because diff_drive_controller commands
  velocity; the arms, lift and head are position-controlled. The LEFT hand's
  fingers are effort-controlled, with the gripper controller's PID turning a
  position target into a force (mrRobot_controllers.yaml): a Webots
  position-controlled motor that is blocked applies its whole force limit,
  so two fingers closed on a jar were two saturated 60 N pushes against each
  other with nothing centring them, and the jar walked sideways out of the
  pads on the first arm move (measured, every pick). As springs, a jar
  pushed off centre is pushed back. The RIGHT hand's fingers stay
  position-controlled: it works the microwave door, closing on the handle
  bar vertically, and springs sag a centimetre under the fingers' own
  weight there and close round the bar lopsided (measured: one finger past
  it, the pull slid off), where the stiff fingers took it squarely every
  time. Both finger joints of a hand are listed even though the URDF mimics
  joint2 from joint1: in Webots each slider is its own motor and both get
  the same command.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="velocity_joint" params="name">
    <joint name="${name}">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="position_joint" params="name">
    <joint name="${name}">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="effort_joint" params="name">
    <joint name="${name}">
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <ros2_control name="MrRobotWebotsSystem" type="system">
    <hardware>
      <plugin>webots_ros2_control::Ros2ControlSystem</plugin>
    </hardware>

    <xacro:velocity_joint name="front_left_wheel_joint"/>
    <xacro:velocity_joint name="front_right_wheel_joint"/>
    <xacro:velocity_joint name="rear_left_wheel_joint"/>
    <xacro:velocity_joint name="rear_right_wheel_joint"/>

    <xacro:position_joint name="lift_joint"/>
    <xacro:position_joint name="openarmx_head_pitch_joint"/>
    <xacro:position_joint name="openarmx_head_yaw_joint"/>

    <xacro:macro name="arm_interfaces" params="side">
      <xacro:position_joint name="openarmx_${side}_joint1"/>
      <xacro:position_joint name="openarmx_${side}_joint2"/>
      <xacro:position_joint name="openarmx_${side}_joint3"/>
      <xacro:position_joint name="openarmx_${side}_joint4"/>
      <xacro:position_joint name="openarmx_${side}_joint5"/>
      <xacro:position_joint name="openarmx_${side}_joint6"/>
      <xacro:position_joint name="openarmx_${side}_joint7"/>
    </xacro:macro>
    <xacro:arm_interfaces side="left"/>
    <xacro:arm_interfaces side="right"/>
    <xacro:effort_joint name="openarmx_left_finger_joint1"/>
    <xacro:effort_joint name="openarmx_left_finger_joint2"/>
    <xacro:position_joint name="openarmx_right_finger_joint1"/>
    <xacro:position_joint name="openarmx_right_finger_joint2"/>
  </ros2_control>
</robot>
