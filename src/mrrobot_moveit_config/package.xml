<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://relaxng.org/ns/structure/1.0"?>
<package format="3">
  <name>mrrobot_moveit_config</name>
  <version>1.0.0</version>
  <description>
    MoveIt 2 configuration for mrRobot: the SRDF (arm, torso-in-chain, head
    and gripper groups), kinematics, joint limits, the mapping onto the
    existing ros2_control trajectory controllers, and the move_group launch.
  </description>
  <maintainer email="a.pahlevani1998@gmail.com">Ali Pahlevani</maintainer>
  <license>MIT</license>
  <url type="website">https://github.com/ali-pahlevani/Mr_Robot</url>
  <url type="repository">https://github.com/ali-pahlevani/Mr_Robot.git</url>
  <url type="bugtracker">https://github.com/ali-pahlevani/Mr_Robot/issues</url>
  <author email="a.pahlevani1998@gmail.com">Ali Pahlevani</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>mrrobot_description</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_kinematics</exec_depend>
  <exec_depend>moveit_planners_ompl</exec_depend>
  <exec_depend>moveit_simple_controller_manager</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>moveit_ros_visualization</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
